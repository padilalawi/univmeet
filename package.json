{
  "name": "univmeet",
  "version": "1.0.0",
  "private": true,
  "description": "UnivMeet - video meeting online berbasis WebRTC (P2P, gratis)",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20261102.1": true,
    "esbuild@0.28.2": true
  }
}
