{
  "name": "univmeet",
  "version": "1.0.0",
  "private": true,
  "description": "UnivMeet - video meeting online berbasis WebRTC (P2P, gratis)",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/e2e-webrtc.js && node test/e2e-screen.js && node test/e2e-multishare.js && node test/audio-check.js && node test/capacity-check.js && node test/quality-scale.js",
    "test:webrtc": "node test/e2e-webrtc.js",
    "test:screen": "node test/e2e-screen.js",
    "test:multishare": "node test/e2e-multishare.js",
    "test:audio": "node test/audio-check.js",
    "test:capacity": "node test/capacity-check.js",
    "test:quality": "node test/quality-scale.js",
    "shots": "node test/screenshot.js",
    "worker:dev": "wrangler dev --config wrangler.worker.jsonc",
    "worker:deploy": "wrangler deploy --config wrangler.worker.jsonc",
    "pages:deploy": "wrangler pages deploy --project-name univmeet --branch main --commit-dirty=true",
    "deploy": "npm run worker:deploy && npm run pages:deploy"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20261102.1": true,
    "esbuild@0.28.2": true
  }
}
