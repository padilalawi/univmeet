{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "univmeet",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDO",
        "script_name": "univmeet"
      }
    ]
  },
  "vars": {
    "MAX_PEERS": "8"
  }
}
